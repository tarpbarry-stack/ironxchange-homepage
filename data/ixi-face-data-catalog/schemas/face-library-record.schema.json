{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://ironxchange.com/schemas/ixi-face-library-record.schema.json",
  "title":"IXI Company Face Library Record",
  "type":"object",
  "required":["schema","faceAppId","companyId","libraryScope","status","latestVersion","versions","audit"],
  "properties":{
    "schema":{"const":"ixi-face-record-v1"},
    "faceAppId":{"type":"string","minLength":1},
    "companyId":{"type":"string","minLength":1},
    "libraryScope":{"enum":["ixi-system","industry-package","company","personal-draft"]},
    "status":{"enum":["draft","active","retired"]},
    "currentDraftVersion":{"type":["integer","null"],"minimum":1},
    "currentPublishedVersion":{"type":["integer","null"],"minimum":1},
    "latestVersion":{"type":"integer","minimum":1},
    "etag":{"type":"string"},
    "permissions":{"type":"object","additionalProperties":true},
    "source":{"type":"object","additionalProperties":true},
    "versions":{
      "type":"array",
      "minItems":1,
      "items":{"$ref":"#/$defs/version"}
    },
    "audit":{"type":"object","additionalProperties":true}
  },
  "$defs":{
    "version":{
      "type":"object",
      "required":["schema","faceAppId","version","label","rendererKind","status","immutable","dataCapabilities","permissionScopes"],
      "properties":{
        "schema":{"const":"ixi-face-version-v1"},
        "faceAppId":{"type":"string","minLength":1},
        "version":{"type":"integer","minimum":1},
        "label":{"type":"string","minLength":1},
        "description":{"type":"string"},
        "rendererKind":{"enum":["declarative","trusted-hardcoded"]},
        "trustedRendererId":{"type":"string"},
        "heightBehavior":{"enum":["bounded","scroll"]},
        "status":{"enum":["draft","active","retired"]},
        "immutable":{"type":"boolean"},
        "checksum":{"type":"string"},
        "dataCapabilities":{"type":"array","items":{"type":"string"},"uniqueItems":true},
        "requiredCapabilities":{"type":"array","items":{"type":"string"},"uniqueItems":true},
        "optionalCapabilities":{"type":"array","items":{"type":"string"},"uniqueItems":true},
        "permissionScopes":{"type":"array","items":{"type":"string"},"uniqueItems":true},
        "compatibleObjectCapabilities":{"type":"array","items":{"type":"string"},"uniqueItems":true},
        "definition":{"type":"object","additionalProperties":true},
        "validation":{"type":"object","additionalProperties":true},
        "audit":{"type":"object","additionalProperties":true}
      },
      "allOf":[
        {"if":{"properties":{"rendererKind":{"const":"trusted-hardcoded"}}},"then":{"required":["trustedRendererId"]}},
        {"if":{"properties":{"status":{"enum":["active","retired"]}}},"then":{"properties":{"immutable":{"const":true}}}}
      ],
      "additionalProperties":true
    }
  },
  "additionalProperties":true
}
